    {
      "id": 4,
      "type": "timeseries",
      "title": "MySQL 초당 쿼리",
      "description": "Queries는 exporter 자신의 조회도 포함한다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(mysql_global_status_queries{job=\"mysqld\"}[$__rate_interval])",
