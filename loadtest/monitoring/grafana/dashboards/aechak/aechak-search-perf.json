    {
      "id": 9,
      "type": "timeseries",
      "title": "Hikari 획득 시간과 타임아웃",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{job=\"spring\"}[$__rate_interval])) / sum(rate(hikaricp_connections_acquire_seconds_count{job=\"spring\"}[$__rate_interval]))",
          "legendFormat": "평균 획득 시간",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(hikaricp_connections_acquire_seconds_max{job=\"spring\"})",
          "legendFormat": "최대 획득 시간",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(increase(hikaricp_connections_timeout_total{job=\"spring\"}[$__rate_interval]))",
          "legendFormat": "타임아웃 건수",
