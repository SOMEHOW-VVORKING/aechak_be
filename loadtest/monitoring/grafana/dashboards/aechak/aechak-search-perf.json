            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",host=\"api\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "api 호스트 전체",
