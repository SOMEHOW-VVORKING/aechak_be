    {
      "id": 3,
      "type": "timeseries",
      "title": "MySQL Threads_running",
      "description": "mysqld_exporter 전역 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "mysql_global_status_threads_running{job=\"mysqld\"}",
          "legendFormat": "Threads_running",
