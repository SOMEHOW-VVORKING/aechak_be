    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP 서버 지연 (검색)",
      "description": "api 안에서 잰 /api/v1/search/products 처리 시간, 구간별 히스토그램",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",uri=\"/api/v1/search/products\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"spring\",uri=\"/api/v1/search/products\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"spring\",uri=\"/api/v1/search/products\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"spring\",uri=\"/api/v1/search/products\"}[$__rate_interval]))",
          "legendFormat": "평균",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
