    {
      "id": 5,
      "type": "timeseries",
      "title": "InnoDB 버퍼 풀 디스크 읽기",
      "description": "디스크 읽기가 0이 아니면 데이터가 버퍼 풀에 다 올라와 있지 않다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(mysql_global_status_innodb_buffer_pool_reads{job=\"mysqld\"}[$__rate_interval])",
          "legendFormat": "디스크 읽기 (Innodb_buffer_pool_reads)",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "rate(mysql_global_status_innodb_buffer_pool_read_requests{job=\"mysqld\"}[$__rate_interval])",
          "legendFormat": "논리 읽기 (read_requests)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^논리.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
