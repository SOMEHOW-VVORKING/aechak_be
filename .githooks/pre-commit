#!/bin/sh
#
# ktlint 자동 포맷 pre-commit hook
#
# 활성화 (클론 후 최초 1회):
#   git config core.hooksPath .githooks
#
# 동작: 스테이징에 Kotlin 파일이 있으면 ktlintFormat으로 포맷한 뒤 재스테이징한다.

# 스테이징된 Kotlin 파일만 추림 (없으면 통과)
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kts?$' || true)
[ -z "$staged" ] && exit 0

echo "▶ ktlintFormat 실행..."
if ! ./gradlew ktlintFormat --quiet; then
  echo "✖ ktlintFormat 실패하여 커밋을 중단합니다."
  exit 1
fi

# 포맷으로 수정됐을 수 있는 (원래) 스테이징 파일을 다시 스테이징
echo "$staged" | xargs git add
echo "✔ ktlint 포맷 및 재스테이징 완료"
exit 0
